# ============================================================
# FreeRADIUS Manager - environment configuration
# ./setup.sh writes a .env with generated secrets. To do it by hand, copy this file to .env
# and replace every CHANGE_ME value: docker compose and the backend refuse to start with
# missing or example secrets.
#   openssl rand -hex 32        # JWT_SECRET
#   openssl rand -base64 30     # DB_PASSWORD, RADIUS_SECRET
# Most business settings (currency, grace days, reminders, password rules...) live on the
# Settings page; the values here are only the defaults used until a setting is saved there.
# ============================================================

# ---- Required secrets ----
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
# Fallback shared secret for routers that are not registered on the NAS Devices page.
# At least 12 characters; give each registered router its own secret instead.
RADIUS_SECRET=CHANGE_ME_STRONG_RADIUS_SECRET
# Optional but recommended: the first-run setup wizard asks for this before creating the
# admin account, so nobody else can claim a freshly installed server.
SETUP_TOKEN=

# ---- Database ----
DB_USER=radius_user
DB_NAME=radius
DB_SSL_MODE=disable

# ---- Locale ----
# Timezone for all containers (e.g. Africa/Nairobi). Customers are cut off at midnight in
# this timezone when their paid-until date passes. The backend also sets it on its database
# sessions (override with DB_TIMEZONE), so a managed database that runs in UTC (Supabase, RDS)
# still counts days in your zone; it logs an error at startup if the two disagree. FreeRADIUS,
# if it runs elsewhere, must use the same TZ.
TZ=UTC
# Default currency for plans and invoices (ISO code, e.g. KES, USD).
DEFAULT_CURRENCY=KES
# Default country for new CRM customers.
DEFAULT_COUNTRY=

# ---- Web ----
# Host port for the web UI (the API is reached through it at /api).
UI_PORT=8081
# HTTPS (Caddy + Let's Encrypt): set DOMAIN to a DNS name pointing at this server, open
# ports 80/443, and set COMPOSE_PROFILES=https so every `docker compose up` includes Caddy.
DOMAIN=
COMPOSE_PROFILES=
# Extra proxies allowed to set X-Forwarded-For, comma-separated CIDRs. Leave empty for the
# default (loopback + Docker networks); set it if a load balancer sits in front.
TRUSTED_PROXIES=
# Only if a browser app on another origin calls the API.
CORS_ORIGINS=

# ---- Sessions and login protection ----
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h
# Idle staff sessions end after this many seconds.
SESSION_TIMEOUT=3600
BCRYPT_COST=12
# API requests per minute per IP.
RATE_LIMIT=300
BRUTE_FORCE_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT=15
PASSWORD_MIN_LENGTH=12


# ---- M-Pesa (Safaricom Daraja) ----
# Off unless MPESA_CONSUMER_KEY is set. Create an app at https://developer.safaricom.co.ke,
# start with the sandbox (test money): shortcode 174379 and the passkey Safaricom shows for
# it. Customers then get "Pay with M-Pesa" in the portal and staff an "M-Pesa prompt"
# button on invoices; paybill/till payments with the username as account number are matched
# automatically (Settings -> M-Pesa -> "Tell Safaricom where to send paybill payments").
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Where paybill/till payments are registered, if not MPESA_SHORTCODE. In the sandbox it is the
# separate 600xxx test code from the Daraja test credentials page (174379 only does prompts).
MPESA_C2B_SHORTCODE=
# paybill or till (Buy Goods; then MPESA_TILL is the till number customers pay to).
MPESA_TYPE=paybill
MPESA_TILL=
# This system's public https address; Safaricom posts payment results here.
MPESA_CALLBACK_URL=
# Secret part of the callback URLs: openssl rand -hex 16
MPESA_CALLBACK_TOKEN=
# Optional, recommended in production: only these addresses may post callbacks (Safaricom
# publishes its list), comma separated, e.g. 196.201.214.200,196.201.214.206
MPESA_ALLOWED_IPS=
# true: refuse paybill payments whose account number matches no customer (needs Safaricom
# to enable validation on your shortcode). Otherwise they are kept for staff to allocate.
MPESA_C2B_REJECT_UNKNOWN=false
# ---- Email (alerts, reminders, daily report) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ---- SMS (optional; any HTTP SMS gateway) ----
# SMS_GATEWAY is the URL that is POSTed to. SMS_BODY_TEMPLATE may use {to}, {message},
# {sender} and {api_key}; SMS_AUTH_HEADER is an extra header such as "apiKey: {api_key}".
# See backend/internal/handlers/sms.go.
SMS_GATEWAY=
SMS_API_KEY=
SMS_AUTH_HEADER=
SMS_SENDER_ID=
SMS_BODY_TEMPLATE=
SMS_CONTENT_TYPE=

# ---- Backups ----
# Daily pg_dump files in ./backups are deleted after this many days. Copy them off-site.
BACKUP_RETENTION_DAYS=14

# ---- Other ----
APP_ENV=production
# Webhooks to private/LAN addresses are refused unless true.
WEBHOOK_ALLOW_PRIVATE=false
# GeoIP lookups for country blocking. The default free service is non-commercial only.
GEOIP_API_URL=
NMAP_MAX_PREFIX=18
NMAP_MAX_PORTSCAN_HOSTS=512
