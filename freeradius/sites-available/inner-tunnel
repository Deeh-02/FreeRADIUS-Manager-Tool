# Inner (tunnelled) authentication for PEAP/TTLS: the outer EAP handshake in `default`
# normally hands the inner credentials to this virtual server on loopback. It listens on
# 127.0.0.1 inside the FreeRADIUS container, so publishing 18120/udp in docker-compose.yml
# has no effect. EAP relies on the eap module and certificates from the base image's raddb,
# which are not part of this repo (EAP/PEAP has not been tested here).
server inner-tunnel {
    listen {
        ipaddr = 127.0.0.1
        port = 18120
        type = auth
    }

    authorize {
        filter_username
        chap
        mschap
        suffix
        update control {
            &Proxy-To-Realm := LOCAL
        }
        eap {
            ok = return
        }
        files
        sql
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        eap
    }

    session {
        sql
    }

    post-auth {
        sql
        Post-Auth-Type REJECT {
            sql
            attr_filter.access_reject
        }
    }

    pre-proxy {}
    post-proxy {
        eap
    }
}
