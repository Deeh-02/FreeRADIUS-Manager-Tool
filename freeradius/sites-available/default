# Request flow for a normal login: listen -> authorize (`sql` loads the user's
# radcheck/radreply rows; `expiration` rejects past an Expiration date and caps
# Session-Timeout at it; `logintime` acts on Login-Time; `datacounter`/`timecounter`
# (mods-available/quota) enforce Max-Octets and Max-All-Session; `pap`/`chap`/`mschap` pick
# how the password will be checked) -> authenticate (compares against radcheck's
# Cleartext-Password) -> post-auth (`sql` logs to radpostauth).
# Accounting packets go to `accounting { sql }` -> radacct.
#
# FreeRADIUS never reads radius_users or invoices. The API turns their state into radcheck
# rows (handlers/access.go): Auth-Type := Reject for suspended/expired customers, Expiration
# for the paid-until date, Simultaneous-Use for the device limit, Max-Octets for data caps.
server default {
    listen {
        type   = auth
        ipaddr = *
        port   = 1812
    }

    listen {
        type   = acct
        ipaddr = *
        port   = 1813
    }

    authorize {
        filter_username
        preprocess
        chap
        mschap
        suffix
        eap {
            ok = return
        }
        files
        sql
        expiration
        logintime
        datacounter
        timecounter
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        eap
    }

    preacct {
        preprocess
        acct_unique
        suffix
    }

    accounting {
        sql
        exec
        attr_filter.accounting_response
    }

    # Enforces Simultaneous-Use (the per-user device limit): counts open radacct rows via
    # simul_count_query in queries.conf. It trusts accounting, so sessions whose Stop packet
    # never arrived keep counting until the scheduler's cleanup_sessions closes them.
    session {
        sql
    }

    post-auth {
        update {
            &reply: += &session-state:
        }
        sql
        exec
        remove_reply_message_if_eap
        Post-Auth-Type REJECT {
            sql
            attr_filter.access_reject
            eap
            remove_reply_message_if_eap
        }
        Post-Auth-Type Challenge {}
    }

    pre-proxy {}
    post-proxy {
        eap
    }
}
